{
    "name": "drawdy-peek-notes",
    "version": "1.0.0",
    "description": "Peek Notes for Drawdy: tuck the details and sources inside any box behind a bookmark, and open them on the board when you need them.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "css": "node scripts/build-css.mjs",
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build-css.mjs && node build.ts",
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit",
        "preflight": "node scripts/preflight.mjs"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "1.3.0",
        "@rollup/plugin-typescript": "^12.1.2",
        "@tailwindcss/cli": "4.3.3",
        "@types/node": "^24",
        "fflate": "^0.8.2",
        "rollup": "^4.34.0",
        "tailwindcss": "4.3.3",
        "tslib": "^2.8.1",
        "tsx": "^4.20.0",
        "typescript": "^5",
        "vite": "^8.2.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild"
        ]
    }
}
